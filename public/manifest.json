{
  "manifest_version": 3,
  "name": "Job Autofill",
  "version": "0.1.0",
  "description": "Fill job application forms with your saved profile in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Autofill this form",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "commands": {
    "pick-field": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Pick a field and save an answer for it"
    }
  }
}
