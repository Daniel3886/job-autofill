{
  "name": "job-autofill",
  "version": "0.1.0",
  "description": "Chrome/Chromium extension that fills job application forms in one click",
  "scripts": {
    "build": "vite build && vite build -c vite.content.config.ts --mode content && vite build -c vite.content.config.ts --mode picker",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src vite.config.ts vite.content.config.ts"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "private": true
}
